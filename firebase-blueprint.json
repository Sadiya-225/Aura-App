{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a Sevi user profile.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The Firebase Auth UID." },
        "displayName": {
          "type": "string",
          "description": "User's display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's email address."
        },
        "seviId": {
          "type": "string",
          "description": "Unique short code (e.g., SEVI-K7PQ)."
        },
        "avatar": {
          "type": "string",
          "description": "Emoji character for avatar."
        },
        "bio": { "type": "string", "description": "Short user biography." },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the account was created."
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "seviId",
        "avatar",
        "createdAt"
      ]
    },
    "Friendship": {
      "title": "Friendship",
      "description": "Represents a directional friendship link.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The user who added the friend."
        },
        "friendId": {
          "type": "string",
          "description": "The user being added."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the friendship was created."
        }
      },
      "required": ["userId", "friendId", "createdAt"]
    },
    "SeviEntry": {
      "title": "SeviEntry",
      "description": "A single sevi recognition event.",
      "type": "object",
      "properties": {
        "fromUserId": { "type": "string", "description": "The giver's UID." },
        "toUserId": { "type": "string", "description": "The recipient's UID." },
        "points": { "type": "integer", "description": "Sevi points (1-100)." },
        "category": {
          "type": "string",
          "enum": ["Style", "Wit", "Depth", "Vibe", "Taste"],
          "description": "The lens of recognition."
        },
        "note": {
          "type": "string",
          "description": "The personal note describing the moment."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the entry was created."
        },
        "month": {
          "type": "string",
          "description": "YYYY-MM string for score aggregation."
        },
        "year": {
          "type": "integer",
          "description": "Year for score aggregation."
        }
      },
      "required": [
        "fromUserId",
        "toUserId",
        "points",
        "category",
        "note",
        "createdAt",
        "month",
        "year"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents."
    },
    "/friendships/{friendshipId}": {
      "schema": "Friendship",
      "description": "Friendship links."
    },
    "/sevi_entries/{entryId}": {
      "schema": "SeviEntry",
      "description": "Sevi recognition entries."
    }
  }
}
